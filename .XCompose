<Multi_key> <o> <m> <i> : "ο" U03BF  # [MNEMONIC] Greek small letter omicron
<Multi_key> <p> <i>     : "π" U03C0  # [MNEMONIC] Greek small letter pi
<Multi_key> <r> <h> <o> : "ρ" U03C1  # [MNEMONIC] Greek small letter rho
<Multi_key> <s> <i> <g> : "σ" U03C3  # [MNEMONIC] Greek small letter sigma
