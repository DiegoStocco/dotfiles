<Multi_key> <P> <i>     : "Π" U03A0  # [MNEMONIC] Greek capital letter Pi
<Multi_key> <R> <h> <o> : "Ρ" U03A1  # [MNEMONIC] Greek capital letter Rho
<Multi_key> <S> <i> <g> : "Σ" U03A3  # [MNEMONIC] Greek capital letter Sigma
